FROM gcfntnu/r-base-conda:4.1.1

RUN apt-get update -qq && apt-get install -y --no-install-recommends apt-utils && apt-get -y install \
  build-essential \
  libreadline-dev \
  cmake \
  gfortran \
  tzdata \
  fonts-dejavu \
  python3-dev \
  python3-pip \
  libpcre++-dev \
  libz-dev \
  libmagick++-dev \
  libhdf5-dev \
  libreadline-dev \
  liblzma-dev \
  libgit2-dev \
  libcgal-dev \
  libglu1-mesa-dev \
  libx11-dev \
  libxml2-dev \
  ghostscript \
  xdg-utils \
  libudunits2-dev && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

RUN mamba install --quiet --yes \
    r-cairo \
    font-ttf-ubuntu \
    r-optparse && \
    mamba clean -ai

RUN R --slave -e "install.packages('doParallel', repos='http://cran.rstudio.com/')"
RUN R --slave -e "BiocManager::install(c('RnBeads', 'RnBeads.hg19', 'wateRmelon', 'impute', 'GLAD', 'LOLA', 'GOstats', 'Gviz', 'missMethyl'), dependencies = TRUE)"
